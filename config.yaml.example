# dmt - Data Migration Tool Configuration

source:
  host: localhost
  port: 1433
  database: StackOverflow2010
  user: sa
  password: ${MSSQL_PASSWORD}  # Use environment variable
  schema: dbo

target:
  host: localhost
  port: 5432
  database: stackoverflow
  user: postgres
  password: ${PG_PASSWORD}  # Use environment variable
  schema: public

# SQLite example (test-only — no external server needed). The `database`
# field is the .db file path. Host/port/user/password/schema are ignored.
#
# source:
#   type: sqlite
#   database: ./testdata/source.db
#
# target:
#   type: sqlite
#   database: ./testdata/target.db

profile:
  name: example
  description: |
    Example profile stored in SQLite.
    Update this description for your environment.

migration:
  # Connection pool settings
  max_source_connections: 12   # Source database connection pool size
  max_target_connections: 12   # Target database connection pool size

  # Rows per chunk for transfer
  chunk_size: 200000

  # Maximum partitions for large tables
  max_partitions: 8

  # Number of parallel transfer workers
  workers: 8

  # Tables larger than this will be partitioned (rows)
  large_table_threshold: 5000000

  # Tables to exclude from migration (glob patterns supported)
  exclude_tables:
    - __*           # System tables
    - temp_*        # Temporary tables

  # Directory for state database and logs
  data_dir: ~/.dmt

  # Target table handling: "drop_recreate" (default) or "upsert"
  # - drop_recreate: Drop and recreate tables (ensures schema changes are applied)
  # - upsert: Incremental sync (INSERT new rows, UPDATE changed rows, preserve target-only rows)
  target_mode: drop_recreate

  # Schema object creation options
  create_indexes: true          # Create non-PK indexes after data transfer
  create_foreign_keys: true     # Create foreign key constraints
  create_check_constraints: true # Create CHECK constraints

  # Consistency options
  strict_consistency: false     # Set true to disable NOLOCK (slower but consistent reads)

  # Schema drift reporting (#305). DMT compares the current source
  # schema to the last successful run's snapshot and logs a structured
  # report before transfer. Set true to abort when any drift is detected.
  fail_on_schema_drift: false

  # Schema evolution (#306). Omit this section to keep schema drift
  # reporting read-only. In upsert mode, adding this section opts into
  # compatible target ALTERs before transfer. For this first slice,
  # only added_column is implemented.
  # schema_evolution:
  #   added_column: auto  # auto | log | fail (section default: auto)

  # Validation options
  sample_validation: false      # Enable sample data validation after row count check
  sample_size: 100              # Number of random rows to sample per table

  # Runtime parameter tuning. Enabled by default — a deterministic
  # rule-based controller polls metrics every runtime_tuning_interval
  # and adjusts chunk_size / write_ahead_writers / etc. in response to
  # memory pressure, queue growth, write errors, and CPU headroom.
  # No AI dependency. Pre-#211 this knob was named `ai_adjust`; the
  # old name is still accepted but logs a deprecation warning.
  runtime_tuning: true
  runtime_tuning_interval: 5s

  # Validation pass/fail policy (#253). Default is "fail loud" on any
  # missing-evidence outcome; flip individual flags to false for
  # log-only behavior during initial roll-out. In upsert mode, row-count
  # validation permits extra target rows because source-side deletes are
  # intentionally retained unless delete propagation is configured later.
  validation:
    # When fail_on_timeout: true (default), a row-count query that
    # exceeds ValidationTimeout fails the run. When false, it logs a
    # warning and the run can still be reported successful — the
    # pre-#253 behavior.
    fail_on_timeout: true
    # When fail_on_estimate_mismatch: true (default), an estimated-
    # row-count disagreement (used after exact COUNT timed out) fails
    # the run. When false, it logs a warning only.
    fail_on_estimate_mismatch: true

  # Automation safety
  allow_partial: false          # When false (default), partial migrations (≥1 failed table) exit with code 3 so
                                # Airflow/k8s/CI see them as failures. Set true to restore pre-#248 exit-0 behavior.

# Slack notifications (optional)
slack:
  enabled: false
  webhook_url: ${SLACK_WEBHOOK_URL}
  channel: "#data-engineering"
  username: dmt
