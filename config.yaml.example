# dmt - Data Migration Tool Configuration

source:
  host: localhost
  port: 1433
  database: StackOverflow2010
  user: sa
  password: ${MSSQL_PASSWORD}  # Use environment variable
  schema: dbo

target:
  host: localhost
  port: 5432
  database: stackoverflow
  user: postgres
  password: ${PG_PASSWORD}  # Use environment variable
  schema: public

# SQLite example (test-only — no external server needed). The `database`
# field is the .db file path. Host/port/user/password/schema are ignored.
#
# source:
#   type: sqlite
#   database: ./testdata/source.db
#
# target:
#   type: sqlite
#   database: ./testdata/target.db

profile:
  name: example
  description: |
    Example profile stored in SQLite.
    Update this description for your environment.

migration:
  # Performance tuning is automatic (#461): the deterministic tuner derives
  # workers, chunk_size, connection pools, partitioning, and reader/writer
  # parallelism from your system, the source workload, and completed-run
  # history — and improves run over run. Leave this section free of tuning
  # knobs unless you have a specific reason; see "Advanced tuning overrides"
  # at the bottom of this section.
  # Load-time formulas keep workers within 4-12; schema/history-aware tuning
  # then applies its distinct CPU/target baseline and planned probe policy.
  # The retained memory envelope may clamp the automatic chunk separately.

  # Tables to exclude from migration (glob patterns supported)
  exclude_tables:
    - __*           # System tables
    - temp_*        # Temporary tables

  # Directory for state database and logs
  data_dir: ~/.dmt

  # Target table handling: "drop_recreate" (default) or "upsert"
  # - drop_recreate: Drop and recreate tables (ensures schema changes are applied)
  # - upsert: Incremental sync (INSERT new rows, UPDATE changed rows, preserve target-only rows)
  target_mode: drop_recreate

  # Delete propagation (#351, opt-in). Existing behavior is mode: off.
  # Reconcile is only valid with target_mode: upsert and currently supports
  # interval-gated hard deletes only.
  deletes:
    mode: off                    # off | reconcile
    target_behavior: hard        # hard
    reconcile:
      schedule: interval         # interval
      interval: 168h
      batch_size: 10000
      require_primary_key: true

  # Schema object creation options
  create_indexes: true          # Create non-PK indexes after data transfer
  create_foreign_keys: true     # Create foreign key constraints
  create_check_constraints: true # Create CHECK constraints

  # Consistency options
  # strict_consistency pins source reads to a stable view. Engine matrix:
  # - postgres: exported snapshot; parallel readers and migration-scope partitions;
  #   no writer blocking; table + migration scope; no extra privileges.
  # - mysql/mariadb (InnoDB): repeatable-read sessions opened under a short
  #   LOCK TABLES window; parallel readers; source-table writes pause for the
  #   few milliseconds needed to start sessions; table scope; requires SELECT
  #   and LOCK TABLES. Other MySQL storage engines are rejected.
  # - mssql table scope: shared table lock; parallel readers; source-table writes
  #   wait for that table's full transfer; no privilege beyond normal source reads.
  # - mssql migration scope: database snapshot; parallel readers + partitions;
  #   no writer blocking, with copy-on-write disk cost; requires SQL Server 2016
  #   SP1+, not Azure SQL Database, and CREATE ANY DATABASE, ALTER ANY DATABASE,
  #   CREATE DATABASE in master, or dbcreator membership.
  # - sqlite: one serializable reader by design; its Go drivers expose no WAL
  #   snapshot API; table scope only.
  # Unsupported sources fail before target mutation. Full-table strict jobs
  # validate against a COUNT captured in the same view; live-source drift is
  # reported but does not fail the copy. Incremental date-filter jobs keep normal
  # live-count validation. Long snapshots can retain MVCC history or block writers.
  strict_consistency: false
  # table (default): one stable view per table. migration: PostgreSQL uses one
  # exported snapshot; SQL Server creates one database snapshot and reads every
  # table from it. PostgreSQL resume starts a new epoch; SQL Server resume reuses
  # the surviving dmt_strict_<runid> snapshot or fails closed if missing.
  strict_consistency_scope: table

  # Schema drift reporting (#305). DMT compares the current source
  # schema to the last successful run's snapshot and logs a structured
  # report before transfer. Set true to abort when any drift is detected.
  fail_on_schema_drift: false

  # Schema contract (#403). Omit this section to keep schema drift reporting
  # read-only. Shorthand such as `schema_contract: report` applies one mode to
  # tables, columns, and data_type. The DMT-specific report mode reports drift
  # without applying target schema changes.
  # schema_contract:
  #   tables: report             # evolve | freeze | discard_row | report
  #   columns: discard_value     # evolve | freeze | discard_row | discard_value | report
  #   data_type: report          # evolve | freeze | discard_row | discard_value | report

  # Deprecated schema evolution (#306). This legacy surface still works for
  # existing migrations, but new configs should use schema_contract instead.
  # schema_evolution:
  #   added_column: auto          # auto | log | fail | discard_value | discard (section default: auto)
  #   nullability_change: auto    # auto | log | fail; auto only relaxes to NULL
  #   type_change: log            # auto | log | fail; auto only applies widened source types (default: log)

  # Validation options
  sample_validation: false      # Enable sample data validation after row count check
  sample_size: 100              # Number of random rows to sample per table

  # Runtime parameter tuning. Enabled by default — a deterministic
  # rule-based controller polls metrics every runtime_tuning_interval
  # and adjusts chunk_size / write_ahead_writers / etc. in response to
  # memory pressure, queue growth, write errors, and CPU headroom.
  # No AI dependency. Pre-#211 this knob was named `ai_adjust`; the
  # old name is still accepted but logs a deprecation warning.
  runtime_tuning: true
  runtime_tuning_interval: 5s

  # Validation pass/fail policy (#253). Default is "fail loud" on any
  # missing-evidence outcome; flip individual flags to false for
  # log-only behavior during initial roll-out. In upsert mode, row-count
  # validation permits extra target rows because source-side deletes are
  # retained until DMT supports delete propagation.
  validation:
    # When fail_on_timeout: true (default), a row-count query that
    # exceeds ValidationTimeout fails the run. When false, it logs a
    # warning and the run can still be reported successful — the
    # pre-#253 behavior.
    fail_on_timeout: true
    # When fail_on_estimate_mismatch: true (default), an estimated-
    # row-count disagreement (used after exact COUNT timed out) fails
    # the run. When false, it logs a warning only.
    fail_on_estimate_mismatch: true

  # Automation safety
  allow_partial: false          # When false (default), partial migrations (≥1 failed table) exit with code 3 so
                                # Airflow/k8s/CI see them as failures and checkpoints remain resumable. Set true
                                # to accept the partial outcome as exit 0 and non-resumable.

  # Completion notification policy (#308). These only apply when Slack is
  # enabled/configured below or via ~/.secrets/dmt-config.yaml.
  notify:
    on_success: true
    on_failure: true

  # Coarse tuner switch (#461). "auto" (default) derives performance
  # parameters from your system, the workload, and run history.
  # "manual" disables pre-run derivation entirely — configured values
  # and formula defaults rule. (runtime_tuning above controls the
  # separate mid-run controller.)
  # tuning: auto

  # ---------------------------------------------------------------------
  # Advanced tuning overrides (uncomment only with a specific reason).
  # Any value you set here is PINNED: the tuner will never adjust it, it
  # stops learning better values for that knob, and the run-start
  # "Tuning provenance" log line will show it as pinned. Remove the
  # override to hand the knob back to the tuner.
  # ---------------------------------------------------------------------
  # workers: 8                       # parallel table transfers
  # chunk_size: 200000               # rows per transfer chunk
  # write_ahead_writers: 4           # parallel writers per table
  # parallel_readers: 2              # parallel readers per table (keyset only)
  # read_ahead_buffers: 4            # reader-side buffered chunks
  # max_partitions: 8                # partitions for large tables
  # large_table_threshold: 5000000   # rows before a table is partitioned
  # max_source_connections: 12       # source connection pool size
  # max_target_connections: 12       # target connection pool size
  # max_memory_mb: 8192              # optional ceiling on the container-aware automatic budget

# Slack notifications (optional)
slack:
  enabled: false
  webhook_url: ${SLACK_WEBHOOK_URL}
  channel: "#data-engineering"
  username: dmt
