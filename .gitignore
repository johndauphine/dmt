# Binaries
dmt
dmt-*
*.exe

# Local Go build cache (set as GOCACHE during offline CI runs)
.gocache/

# Config with secrets
*.yaml
!internal/driver/generic/catalogs/*.yaml
*.yml
!examples/*.yaml
!examples/*.yml
# CI-loadable fixture configs (no secrets — passwords come from env vars
# via ${VAR} expansion). See #178 / docs/FIXTURES.md.
!scripts/fixtures/*.yaml
!scripts/fixtures/*.yml
# CI workflow definitions live under .github/workflows/ and are required
# in-repo for GitHub Actions (#230).
!.github/workflows/*.yml

# State database
*.db
*.db-wal
*.db-shm

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/
/dist/

# Logs
*.log

# Dev artifacts
*.bak
*.png
*.jpg
# ...except the embedded WebUI/PWA icon set (tools/genicons), which the
# go:embed directive in internal/webui/assets.go requires to exist in the
# source tree, not just on disk locally.
!internal/webui/static/*.png

# Isolated state dir for integration tests (#230). See
# scripts/integration-test.sh and scripts/fixtures/ci-mssql-pg.yaml.
.dmt-ci-state/
.claude/

# Antigravity CLI local state
.antigravitycli/

# Compiled binary from `go build ./cmd/migrate` (correct output is ./dmt via make build)
/migrate
