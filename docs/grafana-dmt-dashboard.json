{
  "$schema": "https://grafana.com/docs/grafana/latest/dashboards/json-model/",
  "title": "dmt — migration observability",
  "tags": ["dmt", "migration"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "type": "query",
        "query": "label_values(dmt_rows_total, run_id)",
        "current": { "value": "", "text": "All" },
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Throughput (rows/sec, by table)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (table) (rate(dmt_rows_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Bytes/sec (estimated)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (table) (rate(dmt_bytes_total{run_id=~\"$run_id\"}[1m]))",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors by class (rate over 5m)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (error_class) (rate(dmt_errors_total{run_id=~\"$run_id\"}[5m]))",
          "legendFormat": "{{error_class}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active writers + queue depth",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "dmt_writers_active{run_id=~\"$run_id\"}",
          "legendFormat": "writers active"
        },
        {
          "expr": "dmt_writer_queue_depth{run_id=~\"$run_id\"}",
          "legendFormat": "queue depth"
        }
      ]
    },
    {
      "id": 5,
      "title": "Phase timing (median + p95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, phase) (rate(dmt_phase_duration_seconds_bucket[5m])))",
          "legendFormat": "{{phase}} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(dmt_phase_duration_seconds_bucket[5m])))",
          "legendFormat": "{{phase}} p95"
        }
      ]
    },
    {
      "id": 6,
      "title": "Retries (rate)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (table) (rate(dmt_retries_total{run_id=~\"$run_id\"}[5m]))",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Runtime tuning adjustments",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (rule_name, direction) (rate(dmt_runtime_tuning_adjustments_total[5m]))",
          "legendFormat": "{{rule_name}} ({{direction}})"
        }
      ]
    },
    {
      "id": 8,
      "title": "AI fallback rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (surface) (rate(dmt_ai_fallback_total[5m]))",
          "legendFormat": "{{surface}}"
        }
      ]
    }
  ]
}
